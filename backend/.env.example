# --- Supabase (same project as the Flutter app) ---------------------------
# Dashboard > Settings > API. Use the SECRET key (sb_secret_...), backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-secret-key-here

# --- n8n scoring pipeline (backend only; never sent to browser or watcher) --
# Webhook of the batch-scan workflow, e.g. https://n8n.example.com/webhook/...
# Must be https:// (plain http:// is refused at start-up unless the host is
# localhost / 127.x / ::1 or a private-network IP such as 192.168.x.x or 10.x.x.x).
N8N_BATCH_WEBHOOK_URL=
# Shared secret sent as the X-Webhook-Secret header; check it in n8n.
# REQUIRED when N8N_BATCH_WEBHOOK_URL is set (the backend refuses to start otherwise).
N8N_WEBHOOK_SECRET=
# Seconds to wait for n8n per page (default 360). Must exceed the n8n worst case:
# OMR 60 s + Gemini 3 tries x 90 s + 2 x 5 s waits + database work (~345 s).
N8N_TIMEOUT_SECONDS=360

# true = when N8N_BATCH_WEBHOOK_URL is empty, return clearly SIMULATED results
# (a SIMULATION badge shows in the UI). Keep false in production.
SIMULATE_SCANS=false

# Hours without activity (last scan, or creation) before a batch can be force-closed
ABANDONED_BATCH_HOURS=3

# Allowed frontend origin(s), comma separated (exact match, no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Dev only: also allow any private-LAN origin (192.168.x.x, 10.x.x.x, ...)
CORS_ALLOW_LAN=false

# Client IP for login rate limiting (app/security.py client_ip).
# false (default, local runs): only the TCP peer address is used, so nobody can
#   pick their own rate-limit bucket by sending headers.
# true (Render, behind Cloudflare): CF-Connecting-IP, else the RIGHTMOST
#   X-Forwarded-For entry (the one the nearest proxy added), else the peer.
# TRUST_PROXY_HEADERS=false
# Proxies whose X-Forwarded-Proto / -For uvicorn trusts (Dockerfile/Procfile); only
# the request scheme depends on it now. Local: 127.0.0.1. Render: * (together
# with TRUST_PROXY_HEADERS=true).
# FORWARDED_ALLOW_IPS=127.0.0.1

# OMR preprocessing for scanner pages (defaults shown): detect short (8.5x11) or
# long (8.5x13) bond, crop the scan to that sheet (never cutting content;
# CROP_LONG_BOND keeps its old name) and add a mid-grey border so the OMR
# can find the paper edge. The phone capture path is not affected.
# PAD_FOR_OMR=true
# PAD_PERCENT=5
# CROP_LONG_BOND=true

# Optional tuning
# MAX_UPLOAD_MB=12
# Scan-ingest calls handled at once; more get 503 + Retry-After and the watcher
# retries. Keep it >= the number of scanning laptops.
# INGEST_MAX_CONCURRENCY=4
# Pipeline failures (n8n "internal_error_not_saved", HTTP errors, bad replies) per page
# before it is marked permanently failed and the watcher moves the file to skipped/
# MAX_PIPELINE_ATTEMPTS=5
# PREDATE_GRACE_SECONDS=30
# WATCHER_ONLINE_SECONDS=90
# Public URL of THIS backend, written into the one-file watcher installer's
# watcher_config.json (same as the frontend's VITE_API_BASE). Empty = use the
# URL the request came in on.
# WATCHER_API_BASE=https://api.yourdomain.com

# --- Instructor activation email (Brevo, app/mailer.py) ---------------------
# Same Brevo API key and sender as the Flutter app's Supabase functions
# (Supabase > Edge Functions > Secrets: BREVO_API_KEY / BREVO_SENDER_EMAIL).
# When an SAO admin activates a placeholder instructor, the instructor gets
# an email with the "Forgot Password?" sign-in steps.
# Empty = activation still works, but no email is sent: the website shows
# the steps for the admin to pass on in person.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=SAO Management

# Page viewer (migration 010): a smaller viewing copy (long side 1800 px, JPEG
# quality 75, ~250 KB) of every scanned page is kept in this PRIVATE Supabase
# Storage bucket and shown on the batch/review pages. Empty = keep no pictures.
# SCAN_IMAGE_BUCKET=scan-pages
# Pictures older than this are removed (checked at most once an hour). 0 = keep.
# SCAN_IMAGE_RETENTION_DAYS=90
# SCAN_IMAGE_MAX_SIDE=1800
# SCAN_IMAGE_JPEG_QUALITY=75
